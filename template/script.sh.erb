#!/usr/bin/env bash

#
# Launch Xfce Window Manager and Panel
#

(
  export SEND_256_COLORS_TO_REMOTE=1
  export XDG_CONFIG_HOME="<%= session.staged_root.join("config") %>"
  export XDG_DATA_HOME="<%= session.staged_root.join("share") %>"
  export XDG_CACHE_HOME="$(mktemp -d)"
  export $(dbus-launch)

  module restore
  set -x
  xfwm4 --compositor=off --sm-client-disable
  xsetroot -solid "#D3D3D3"
  xfsettingsd --sm-client-disable
  xfce4-panel --sm-client-disable
) &

#
# Start SAS
#

module load firefox
module load <%= context.auto_modules_sas %>

#
# Launch rbrowser with temporary config
#
echo "Starting rbrowser process..."
echo "HELPBROWSER=${HELPBROWSER}"
echo "HELPHOST=${HELPHOST}"
echo "HELPPORT=${HELPPORT}"

RBROWSER_TMP=$(mktemp -d)

cat > "${RBROWSER_TMP}/.rbrowser" <<EOF
browserPath=firefox
browserPause=5
port=${HELPPORT}
accessListCount=0
accessListType=0
EOF

REAL_HOME="$HOME"
HOME="${RBROWSER_TMP}" \
XAUTHORITY="${XAUTHORITY:-${REAL_HOME}/.Xauthority}" \
rbrowser &

RBROWSER_PID=$!
echo "rbrowser pid: $RBROWSER_PID"

#
# Launch SAS
#
set -x
sas -HELPBROWSER "${HELPBROWSER}" \
    -HELPHOST "${HELPHOST}" \
    -HELPPORT "${HELPPORT}" \
    |& tee "<%= session.staged_root.join("run.log") %>"
APP_EXIT_CODE=${PIPESTATUS[0]}
{ set +x; } 2>/dev/null

echo "killing rbrowser pid: $RBROWSER_PID"
kill "$RBROWSER_PID"
wait "$RBROWSER_PID" 2>/dev/null

echo "rbrowser stopped"
